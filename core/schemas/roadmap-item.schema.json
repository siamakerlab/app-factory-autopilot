{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afa:schemas/roadmap-item/v1",
  "title": "로드맵 항목",
  "description": "대상 앱 프로젝트 로드맵의 단일 항목. MVP-1.md 3.4(상태 머신)·3.10(필수 필드) 근거. 상태의 SSOT는 .app-factory/state/roadmap.json이며 ROADMAP.md는 렌더링 산출물이다.",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "requirement",
    "implementation_scope",
    "completion_criteria",
    "depends_on",
    "priority",
    "risk",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^RM-\\d{3}$",
      "description": "로드맵 항목 고유 ID (RM-001 형식)"
    },
    "title": { "type": "string", "minLength": 1 },
    "requirement": {
      "type": "string",
      "minLength": 1,
      "description": "이 항목이 충족해야 하는 요구사항 (사용자 가치 관점)"
    },
    "implementation_scope": {
      "type": "string",
      "minLength": 1,
      "description": "구현 범위 — 포함/제외 경계를 명시"
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "완료 조건. Completion Verifier가 기계적으로 순회하며 각 조건을 검증한다 (MVP-1.md AFA-001 지침)",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "test_criteria": {
      "type": "array",
      "description": "테스트 조건 — 어떤 테스트가 이 항목을 검증하는지",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "runtime_verification_criteria": {
      "type": "array",
      "description": "실행 검증 조건 — 에뮬레이터/실기기에서 확인할 동작",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "depends_on": {
      "type": "array",
      "description": "선행 로드맵 항목 ID 목록 (없으면 빈 배열)",
      "items": { "type": "string", "pattern": "^RM-\\d{3}$" },
      "uniqueItems": true
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"],
      "description": "P0=필수(완료 게이트 대상), P1=필수·후순위, P2=선택"
    },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "status": { "$ref": "#/$defs/status" },
    "feature_grade": {
      "type": "string",
      "enum": ["CORE", "SUPPORTING", "OPTIONAL"],
      "description": "기능 등급 (MVP-1.md 3.11 핵심 기능 분류)"
    },
    "placeholder_refs": {
      "type": "array",
      "description": "이 항목이 의존하는 Placeholder 이름 목록",
      "items": { "type": "string", "pattern": "^\\$\\{PLACEHOLDER_[A-Z0-9_]+\\}$" },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "description": "VERIFIED 전이의 근거 증거 ID. VERIFIED 상태에서는 1개 이상 필수 (전이 검증기가 강제)",
      "items": { "$ref": "#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "status_history": {
      "type": "array",
      "description": "상태 전이 이력. 모든 전이는 여기 기록된다",
      "items": { "$ref": "#/$defs/transition" }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "VERIFIED" } } },
      "then": {
        "required": ["evidence_ids"],
        "properties": { "evidence_ids": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "PARTIAL",
        "IMPLEMENTED",
        "VERIFIED",
        "BLOCKED",
        "NEEDS_HUMAN_DECISION"
      ]
    },
    "role": {
      "type": "string",
      "enum": ["orchestrator", "worker", "verifier", "auditor", "user", "system"]
    },
    "evidenceId": { "type": "string", "pattern": "^E-\\d{4}$" },
    "criterion": {
      "type": "object",
      "required": ["description", "verifiable_by"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "verifiable_by": {
          "type": "string",
          "enum": ["code", "test", "build", "emulator", "manual"],
          "description": "검증 수단 (MVP-1 로드맵 AFA-001 지침의 enum)"
        },
        "satisfied": { "type": "boolean" },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceId" },
          "uniqueItems": true
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "role", "at"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/status" },
        "to": { "$ref": "#/$defs/status" },
        "role": { "$ref": "#/$defs/role" },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "task_id": { "type": "string", "pattern": "^T-\\d{4}$" },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceId" },
          "uniqueItems": true
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afa:schemas/task/v1",
  "title": "작업 (Task Queue 항목)",
  "description": "작업 큐의 단일 작업. .app-factory/task-queue/에 1 작업 = 1 파일로 저장한다 (MVP-1.md 3.7). 클레임 토큰으로 제출 주체를 검증한다 (ROADMAP AFA-011 지침).",
  "type": "object",
  "required": ["version", "id", "type", "title", "status", "attempts", "max_attempts", "created_at"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^T-\\d{4}$" },
    "type": {
      "type": "string",
      "enum": [
        "implement",
        "verify",
        "fix",
        "audit",
        "gate",
        "research",
        "dependency_review",
        "license_review",
        "doc",
        "emulator_qa"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "roadmap_item_id": {
      "type": "string",
      "pattern": "^RM-\\d{3}$",
      "description": "연결된 로드맵 항목 (gate/audit 등 전역 작업은 생략 가능)"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^F-\\d{4}$",
      "description": "fix 작업의 원인 finding"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "claimed", "in_progress", "submitted", "completed", "failed", "cancelled", "blocked"],
      "description": "completed 전이는 verifier role만 가능 (factory_complete_task)"
    },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"], "default": "P1" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T-\\d{4}$" },
      "uniqueItems": true
    },
    "dangerous": {
      "type": "array",
      "description": "강제 중단 조건 태그 (MVP-1.md 3.9). 태그가 있으면 승인 없이 실행 금지 (ROADMAP AFA-024 지침)",
      "items": {
        "type": "string",
        "enum": [
          "git_push",
          "deploy",
          "production_release",
          "signing_change",
          "destructive_db_migration",
          "large_architecture_change",
          "payment_product_change",
          "ad_policy_change",
          "privacy_policy_change",
          "external_account_required",
          "api_cost",
          "data_loss_possible"
        ]
      },
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "description": "클레임 정보. status가 claimed/in_progress/submitted일 때 필수",
      "required": ["role", "agent", "token", "at"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["orchestrator", "worker", "verifier", "auditor"] },
        "agent": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 8 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "attempts": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "default": 3 },
    "last_error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string" },
        "normalized": { "type": "string", "description": "경로·숫자 마스킹 후 문자열 — 동일 오류 반복 판정용 (AFA-024)" },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "result": {
      "type": "object",
      "description": "제출 결과. status가 submitted/completed일 때 필수",
      "required": ["summary", "submitted_at"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "build_ok": { "type": "boolean" },
        "test_ok": { "type": "boolean" },
        "requested_status": {
          "type": "string",
          "enum": ["IMPLEMENTED", "PARTIAL", "BLOCKED"],
          "description": "worker가 요청 가능한 로드맵 상태 — VERIFIED는 요청 불가 (스키마 수준 강제)"
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E-\\d{4}$" },
          "uniqueItems": true
        },
        "submitted_at": { "type": "string", "format": "date-time" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["claimed", "in_progress", "submitted"] } }
      },
      "then": { "required": ["claim"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["submitted", "completed"] } }
      },
      "then": { "required": ["result"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "fix" } }
      },
      "then": { "required": ["finding_id"] }
    }
  ]
}

// 서명 SSOT: 키스토어 폴더의 properties 파일만 참조한다.
// 키스토어·properties가 없으면 릴리스 빌드를 차단한다 (임의 생성 절대 금지).
fun loadSigning(debug: Boolean): Properties? {
    val name = if (debug) "{{project.package_name}}-debug-keystore.properties"
               else "{{project.package_name}}-keystore.properties"
    val file = rootProject.file("{{signing.keystore_dir}}/$name")
    return if (file.exists()) Properties().apply { file.inputStream().use { load(it) } } else null
}

android {
    namespace = "{{project.namespace}}"
    compileSdk = {{sdk.compile}}

    defaultConfig {
        applicationId = "{{project.package_name}}"
        minSdk = {{sdk.min}}
        targetSdk = {{sdk.target}}
        versionCode = {{versioning.initial_code}}   // yymmddrrr — Claude Code 자동 관리
        versionName = "{{versioning.initial_name}}"
        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
    }

    signingConfigs {
        loadSigning(debug = true)?.let { props ->
            getByName("debug") {
                storeFile = rootProject.file("{{signing.keystore_dir}}/" + props.getProperty("storeFile"))
                storePassword = props.getProperty("storePassword")
                keyAlias = props.getProperty("keyAlias")
                keyPassword = props.getProperty("keyPassword")
            }
        }
        loadSigning(debug = false)?.let { props ->
            create("release") {
                storeFile = rootProject.file("{{signing.keystore_dir}}/" + props.getProperty("storeFile"))
                storePassword = props.getProperty("storePassword")
                keyAlias = props.getProperty("keyAlias")
                keyPassword = props.getProperty("keyPassword")
            }
        }
    }

    buildTypes {
        debug {
            applicationIdSuffix = ".debug"
        }
        release {
            isMinifyEnabled = true
            isShrinkResources = true
            proguardFiles(getDefaultProguardFile("proguard-android-optimize.txt"), "proguard-rules.pro")
            // 키스토어가 준비된 경우에만 서명 설정. 부재 시 릴리스 태스크만
            // 실행 시점에 차단한다 (디버그 빌드는 진행 가능해야 함)
            signingConfigs.findByName("release")?.let { signingConfig = it }
        }
    }

    buildFeatures { compose = true }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
}

// 릴리스 차단 게이트: 키스토어 미준비 상태의 릴리스 산출은 실행 시점에 실패
tasks.matching { it.name == "assembleRelease" || it.name == "bundleRelease" }.configureEach {
    doFirst {
        if (loadSigning(debug = false) == null) {
            error(
                "릴리스 키스토어가 없습니다: {{signing.keystore_dir}}/{{project.package_name}}-keystore.properties — " +
                "운영자 절차로 키스토어를 준비하십시오 (자동 생성 금지)."
            )
        }
    }
}

